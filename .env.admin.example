# 관리자 배포 프로젝트 전용. 실제 값은 Vercel 환경변수에 입력하세요.
WILLCLUB_DEPLOY_TARGET=admin
SITE_ORIGIN=https://your-admin.vercel.app
NEXT_PUBLIC_FRONT_SITE_URL=https://your-frontend.vercel.app
NEXT_PUBLIC_ADMIN_SITE_URL=https://your-admin.vercel.app
# 프론트와 동일한 외부 MySQL을 사용해야 영상·쿠폰 변경이 고객 화면에 반영됩니다.
DATABASE_URL=
# 실제 관리자 인증 어댑터 또는 실제 OAuth 연결 필요. 공용 기본 계정은 없습니다.
AUTH_ADAPTER_MODULE=
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
WILLCLUB_ADMIN_OPEN_IDS=
WILLCLUB_EXPERT_OPEN_IDS={}
# Vercel에서 영상 업로드 테스트를 하려면 영속 메타데이터 DB와 외부 FTP 저장소 필요.
# 4MB 이상의 강의 업로드는 추후 단독 Node.js 서버에서 수행하세요.
VIDEO_METADATA_MYSQL=false
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=
VIDEO_PUBLIC_BASE_URL=
FTP_SECURE=true
