# Node.js 22 이상. 이 파일을 .env 로 복사하세요. 실제 비밀값은 ZIP/Git에 넣지 마세요.
HOST=0.0.0.0
PORT=3000
# 운영 HTTPS에서는 정확한 공개 origin을 사용합니다. 경로/마지막 slash 없음.
SITE_ORIGIN=http://localhost:3000

# 기본 로컬 단일 프로세스 모드: 아래 FTP/DB 항목은 모두 비워둡니다.
# 서버 재시작 후에도 유지되는 디스크 경로를 사용하세요.
STATE_FILE=data/runtime/state.json
LOCAL_VIDEO_DIRECTORY=data/runtime/media
VIDEO_METADATA_FILE=data/runtime/video-metadata.json
UPLOAD_TEMP_DIR=data/runtime/tmp
LOCAL_VIDEO_BASE_URL=
MAX_UPLOAD_MB=500
MAX_CONCURRENT_UPLOADS=2
UPLOAD_TIMEOUT_SECONDS=1800

# 기존 윌클럽 인증/회원 DB가 있으면 이 서버 전용 어댑터를 우선 사용하세요.
# server/auth-adapter.example.mjs 를 복사한 실제 구현 파일을 설정합니다.
AUTH_ADAPTER_MODULE=

# 기존 인증 어댑터가 없을 때의 기본 Manus OAuth 연결.
# 서비스가 제공하는 실제 값을 사용합니다. 로컬 임의 값으로 운영 권한을 주지 마세요.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
# 인증된 openId 중 관리자/전문가 권한을 서버에서 명시합니다. 자동 관리자 승격 없음.
WILLCLUB_ADMIN_OPEN_IDS=
WILLCLUB_EXPERT_OPEN_IDS={}

# 기존 영상 kit와 동일한 서버 간 검증용 토큰. 무작위 32자 이상. 브라우저 코드에 넣지 마세요.
ADMIN_API_TOKEN=

# 운영 MySQL: 별도 willclub_app_state JSON 테이블이 생성됩니다.
# 기존 서비스 전체 DB 마이그레이션/고객 결제 연동이 완료되었다는 의미가 아닙니다.
DATABASE_URL=
# 영상 메타데이터까지 MySQL로 관리하려면 원본 sql/schema.sql 적용 후 true.
VIDEO_METADATA_MYSQL=false

# FTP를 쓸 때 아래 5개를 모두 설정해야 합니다. 부분 설정은 오류로 종료합니다.
# 제공된 호스트는 jnbstock3.mireene.com 입니다. .env 에 실제 계정/경로를 입력하세요.
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=
VIDEO_PUBLIC_BASE_URL=
FTP_SECURE=true
FTP_PORT=21
FTP_TIMEOUT_SECONDS=120

# 고객 메뉴는 같은 프로젝트의 상대 경로로 연결합니다. 외부 테스트 서버 주소를 사용하지 않습니다.

# Vercel 테스트: SITE_ORIGIN을 실제 Vercel/연결 도메인 origin으로 변경 후 재배포하세요.
# Next.js Route Handlers가 /api, /auth, /media, /health를 제공합니다.
# Vercel에서 관리자 변경을 유지하려면 DATABASE_URL에 외부 MySQL을 설정해야 합니다.
# DB 미설정 시 공개 seed 목록/인증된 관리자 조회만 허용하며 저장을 성공으로 표시하지 않습니다.
# 관리자 로그인은 위 AUTH_ADAPTER_MODULE 또는 실제 OAuth 설정 + 관리자 openId 허용 목록이 필요합니다.
# Vercel 함수의 요청/응답은 4.5MB 제한이 있어 실제 강의 대용량 업로드는 단독 Node.js 서버에서 진행하세요.

# 각각 배포할 때 frontend / admin. 한 서버에서 함께 제공할 때 all.
# 별도 배포 ZIP의 deployment.config.json 기본 대상보다 이 변수가 우선합니다.
WILLCLUB_DEPLOY_TARGET=admin
NEXT_PUBLIC_FRONT_SITE_URL=
NEXT_PUBLIC_ADMIN_SITE_URL=
# 단독 서버를 둘로 나누고 로컬 미디어를 사용하는 경우 두 프로세스의 영속 미디어 폴더를 공유하세요.
# 관리자 업로드 URL은 고객 도메인의 /media를 사용하고 두 서버가 같은 DB와 미디어를 읽도록 구성합니다.
# Vercel에는 적용하지 않으며, Vercel 미디어 업로드는 외부 FTP+영속 메타데이터 DB가 필요합니다.

# KICC EasyPay 일반 결제창 (서버 전용, 실제 값은 배포 환경변수에 입력)
WILLCLUB_EASYPAY_ENABLED=false
WILLCLUB_EASYPAY_MALL_ID=
WILLCLUB_EASYPAY_SECRET=
WILLCLUB_EASYPAY_API_DOMAIN=https://testpgapi.easypay.co.kr
