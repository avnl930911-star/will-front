# 프론트 배포 프로젝트 전용. 실제 값은 Vercel 환경변수에 입력하세요.
WILLCLUB_DEPLOY_TARGET=frontend
SITE_ORIGIN=https://your-frontend.vercel.app
NEXT_PUBLIC_FRONT_SITE_URL=https://your-frontend.vercel.app
NEXT_PUBLIC_ADMIN_SITE_URL=https://your-admin.vercel.app
# 두 프로젝트에 동일한 외부 MySQL URL을 설정하면 영상·쿠폰 변경이 공유됩니다.
DATABASE_URL=
# 회원 로그인/쿠폰용 인증이 필요하면 실제 인증 어댑터 또는 OAuth 값을 설정합니다.
AUTH_ADAPTER_MODULE=
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
# 관리자 권한은 프론트 API에 허용되지 않습니다.
WILLCLUB_ADMIN_OPEN_IDS=

# KICC EasyPay 일반 결제창 (서버 전용, 실제 값은 배포 환경변수에 입력)
WILLCLUB_EASYPAY_ENABLED=false
WILLCLUB_EASYPAY_MALL_ID=
WILLCLUB_EASYPAY_SECRET=
WILLCLUB_EASYPAY_API_DOMAIN=https://testpgapi.easypay.co.kr
